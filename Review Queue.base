filters:
  and:
    - 'file.ext == "md"'
    - not:
        - file.inFolder("Auto Memory")
    - 'file.name != "README"'

formulas:
  days_since_review: 'if(reviewed, (today() - date(reviewed)).days, "")'

properties:
  reviewed:
    displayName: Reviewed
  formula.days_since_review:
    displayName: "Days since review"

views:
  - type: table
    name: Due
    filters:
      or:
        - '!reviewed'
        - '(today() - date(reviewed)).days > 90'
    order:
      - file.name
      - reviewed
      - formula.days_since_review
