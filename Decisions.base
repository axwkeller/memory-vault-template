filters:
  and:
    - type == "decision"
    - file.ext == "md"
    - not:
        - file.inFolder("Auto Memory")
properties:
  date:
    displayName: Date
  project:
    displayName: Project
  reviewed:
    displayName: Reviewed
views:
  - type: table
    name: Decisions
    order:
      - file.name
      - date
      - project
      - reviewed
    sort:
      - property: date
        direction: DESC
  - type: table
    name: By project
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - date
      - reviewed
    sort:
      - property: date
        direction: DESC
