filters:
  and:
    - type == "project"
    - file.ext == "md"
formulas:
  days_since_review: if(reviewed, (today() - date(reviewed)).days, "")
properties:
  status:
    displayName: Status
  repo:
    displayName: Repo
  reviewed:
    displayName: Reviewed
  formula.days_since_review:
    displayName: Days since review
views:
  - type: table
    name: Projects
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - repo
      - reviewed
  - type: table
    name: Active
    filters:
      and:
        - status == "active"
    order:
      - file.name
      - repo
      - formula.days_since_review
